{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Arashi Works Release Manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "productId",
        "channel",
        "version",
        "releasedAt",
        "summary",
        "assets"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "productId": {
            "type": "string",
            "minLength": 1
        },
        "channel": {
            "const": "stable"
        },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "releasedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
        },
        "summary": {
            "type": "string",
            "minLength": 1
        },
        "releaseNotesUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
        },
        "minimumOsVersion": {
            "type": "string",
            "minLength": 1
        },
        "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "platform",
                    "architecture",
                    "packageType",
                    "filename",
                    "url",
                    "size",
                    "sha256"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "platform": {
                        "const": "windows"
                    },
                    "architecture": {
                        "enum": [
                            "x64",
                            "arm64"
                        ]
                    },
                    "packageType": {
                        "enum": [
                            "installer",
                            "portable",
                            "archive"
                        ]
                    },
                    "filename": {
                        "type": "string",
                        "minLength": 1
                    },
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                    },
                    "fallbackUrl": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    }
                }
            }
        }
    }
}
