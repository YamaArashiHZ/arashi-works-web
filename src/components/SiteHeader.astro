---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
    <a class="site-brand" href="/">
        <strong>{site.name}</strong>
        <span>{site.nameZh}</span>
    </a>

    <ThemeToggle />

    <button
        class="site-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-navigation"
    >
        <svg
            class="site-nav-toggle-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >
            <path class="icon-line icon-line-top" d="M4 12h16"></path>
            <path class="icon-line icon-line-middle" d="M4 12h16"></path>
            <path class="icon-line icon-line-bottom" d="M4 12h16"></path>
        </svg>
        <span class="visually-hidden">菜单</span>
    </button>

    <nav id="site-navigation" aria-label="主导航">
        <ul class="site-nav">
            <li>
                <a
                    href="/"
                    aria-current={currentPath === "/" ? "page" : undefined}
                    >首页</a
                >
            </li>
            <li>
                <a
                    href="/works/"
                    aria-current={currentPath.startsWith("/works/")
                        ? "page"
                        : undefined}>作品</a
                >
            </li>
            <li>
                <a
                    href="/notes/"
                    aria-current={currentPath.startsWith("/notes/")
                        ? "page"
                        : undefined}>异造手记</a
                >
            </li>
            <li>
                <a
                    href="/search/"
                    aria-current={currentPath.startsWith("/search/")
                        ? "page"
                        : undefined}
                >
                    搜索
                </a>
            </li>
            <li>
                <a
                    href="/about/"
                    aria-current={currentPath.startsWith("/about/")
                        ? "page"
                        : undefined}>关于</a
                >
            </li>
        </ul>
    </nav>
</header>

<script>
    const siteHeader = document.querySelector(".site-header");
    const navToggle = document.querySelector(".site-nav-toggle");
    const mobileNavigationQuery = window.matchMedia("(max-width: 50rem)");

    if (
        siteHeader instanceof HTMLElement &&
        navToggle instanceof HTMLButtonElement
    ) {
        siteHeader.dataset.navReady = "";

        navToggle.addEventListener("click", () => {
            siteHeader.dataset.navAnimated = "";

            const isExpanded =
                navToggle.getAttribute("aria-expanded") === "true";
            navToggle.setAttribute("aria-expanded", String(!isExpanded));
        });

        document.addEventListener("keydown", (event) => {
            const isExpanded =
                navToggle.getAttribute("aria-expanded") === "true";

            if (event.key === "Escape" && isExpanded) {
                navToggle.setAttribute("aria-expanded", "false");
                navToggle.focus();
            }
        });

        mobileNavigationQuery.addEventListener("change", () => {
            navToggle.setAttribute("aria-expanded", "false");
            delete siteHeader.dataset.navAnimated;
        });
    }
</script>

<style>
    .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        width: min(100%, var(--width-page));
        margin-inline: auto;
        gap: 1rem;
        padding: 1rem var(--space-page);
        position: relative;
        z-index: 10;
    }

    .site-brand {
        display: flex;
        flex-direction: column;
        color: inherit;
        text-decoration: none;
    }

    .site-nav-toggle {
        display: none;
    }

    .site-nav-toggle-icon {
        display: block;
        width: 1.5rem;
        height: 1.5rem;
    }

    .icon-line {
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        transform-origin: 12px 12px;
        transition:
            transform 180ms ease,
            opacity 140ms ease;
    }

    .icon-line-top {
        transform: translateY(-6px);
    }

    .icon-line-bottom {
        transform: translateY(6px);
    }

    .site-nav-toggle[aria-expanded="true"] .icon-line-top {
        transform: rotate(-45deg);
    }

    .site-nav-toggle[aria-expanded="true"] .icon-line-middle {
        opacity: 0;
    }

    .site-nav-toggle[aria-expanded="true"] .icon-line-bottom {
        transform: rotate(45deg);
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (max-width: 50rem) {
        .site-header[data-nav-ready] .site-nav-toggle {
            display: block;
        }

        #site-navigation {
            position: absolute;
            z-index: 1;
            inset-block-start: calc(100% - 0.5rem);
            inset-inline-end: var(--space-page);
            width: min(10rem, calc(100% - 2 * var(--space-page)));
            padding: 1rem;
            border: 1px solid var(--color-border);
            border-radius: 0.75rem;
            background: var(--color-surface-raised);
            box-shadow: 0 0.75rem 2rem var(--color-shadow);
        }

        .site-header[data-nav-ready] #site-navigation {
            visibility: hidden;
            opacity: 0;
            transform: translateY(-0.5rem) scale(0.98);
            transform-origin: top right;
            pointer-events: none;
        }

        .site-header[data-nav-ready][data-nav-animated] #site-navigation {
            transition:
                opacity 180ms ease,
                transform 180ms ease,
                visibility 0s linear 180ms;
        }

        .site-header[data-nav-ready]
            .site-nav-toggle[aria-expanded="true"]
            + #site-navigation {
            visibility: visible;
            opacity: 1;
            transform: none;
            pointer-events: auto;
            transition-delay: 0s;
        }

        .site-nav {
            flex-direction: column;
        }
    }

    .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .site-nav a[aria-current="page"] {
        font-weight: 700;
        text-decoration-thickness: 0.15em;
    }
</style>
