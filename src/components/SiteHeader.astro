---
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
    <a class="site-brand" href="/">
        <strong>{site.name}</strong>
        <span>{site.nameZh}</span>
    </a>

    <nav aria-label="主导航">
        <ul class="site-nav">
            <li><a
                href="/"
                aria-current={currentPath === '/' ? 'page' : undefined}
            >首页</a></li>
            <li><a
                href="/works/"
                aria-current={currentPath.startsWith('/works/') ? 'page' : undefined}
            >作品</a></li>
            <li><a
                href="/notes/"
                aria-current={currentPath.startsWith('/notes/') ? 'page' : undefined}
            >异造手记</a></li>
            <li><a
                href="/about/"
                aria-current={currentPath.startsWith('/about/') ? 'page' : undefined}
            >关于</a></li>
        </ul>
    </nav>
</header>
<style>
    .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem var(--space-page);
    }

    .site-brand {
        display: flex;
        flex-direction: column;
        color: inherit;
        text-decoration: none;
    }

    .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .site-nav a[aria-current="page"] {
        font-weight: 700;
        text-decoration-thickness: 0.15em;
    }
</style>