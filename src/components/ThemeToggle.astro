<button class="theme-toggle" type="button" aria-label="切换主题" hidden>
    <svg
        class="theme-toggle-icon"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
    >
        <defs>
            <mask
                id="theme-icon-body-mask"
                maskUnits="userSpaceOnUse"
                x="0"
                y="0"
                width="32"
                height="32"
            >
                <rect width="32" height="32" fill="white"></rect>
                <circle
                    class="theme-icon-sun-hole"
                    cx="16"
                    cy="16"
                    r="6.18"
                    fill="black"></circle>
            </mask>
        </defs>

        <g class="theme-icon-rays">
            <path class="theme-icon-ray" d="M16 1.65V3.71"></path>
            <path class="theme-icon-ray" d="M26.15 5.85L24.69 7.31"></path>
            <path class="theme-icon-ray" d="M30.35 16H28.29"></path>
            <path class="theme-icon-ray" d="M26.15 26.15L24.69 24.69"></path>
            <path class="theme-icon-ray" d="M16 30.35V28.29"></path>
            <path class="theme-icon-ray" d="M5.85 26.15L7.31 24.69"></path>
            <path class="theme-icon-ray" d="M1.65 16H3.71"></path>
            <path class="theme-icon-ray" d="M5.85 5.85L7.31 7.31"></path>
        </g>

        <circle
            class="theme-icon-body"
            cx="16"
            cy="16"
            r="8.93"
            mask="url(#theme-icon-body-mask)"></circle>

        <path
            class="theme-icon-moon"
            transform="scale(0.03125)"
            d="M512.576 896A384.96 384.96 0 0 1 128 511.424a383.36 383.36 0 0 1 102.72-261.632A383.168 383.168 0 0 1 482.112 128a30.656 30.656 0 0 1 26.944 48.832 239.488 239.488 0 0 0-47.552 144 241.92 241.92 0 0 0 241.6 241.6c52.352 0 102.08-16.448 144-47.552a30.592 30.592 0 0 1 48.832 26.944 383.232 383.232 0 0 1-121.728 251.392A383.232 383.232 0 0 1 512.64 896zM425.216 200.192c-136.32 38.464-235.968 164.928-235.968 311.232a323.648 323.648 0 0 0 323.328 323.328c146.304 0 272.768-99.584 311.232-235.968a303.232 303.232 0 0 1-398.592-398.592z"
        ></path>
    </svg>

    <span data-theme-label>切换主题</span>
</button>

<style>
    .theme-toggle {
        position: relative;
        display: inline-grid;
        place-items: center;
        flex: none;
        width: 2.75rem;
        height: 2.75rem;
        margin-inline-start: auto;
        padding: 0.625rem;
        border: 0;
        border-radius: 50%;
        background: transparent;
        transition: background-color 140ms ease;
        color: inherit;
        cursor: pointer;
    }

    .theme-toggle[hidden] {
        display: none;
    }

    .theme-toggle:hover,
    .theme-toggle:focus-visible {
        background-color: color-mix(
            in srgb,
            currentColor 12%,
            transparent
        );
    }

    .theme-toggle:active {
        background-color: color-mix(
            in srgb,
            currentColor 18%,
            transparent
        );
    }

    .theme-toggle [data-theme-label] {
        position: absolute;
        z-index: 20;
        inset-block-start: calc(100% + 0.5rem);
        inset-inline-start: 50%;
        width: max-content;
        max-width: 12rem;
        padding: 0.3rem 0.55rem;
        border-radius: 0.375rem;
        background: var(--color-text-primary);
        color: var(--color-background);
        font-size: 0.8125rem;
        line-height: 1.4;
        white-space: nowrap;
        visibility: hidden;
        opacity: 0;
        transform: translate(-50%, -0.25rem);
        pointer-events: none;
        transition:
            opacity 104ms ease,
            transform 140ms ease,
            visibility 0s linear 140ms;
    }

    .theme-toggle:hover [data-theme-label],
    .theme-toggle:focus-visible [data-theme-label] {
        visibility: visible;
        opacity: 1;
        transform: translate(-50%, 0);
        transition-delay: 0s;
    }

    .theme-toggle-icon {
        width: 1.5rem;
        height: 1.5rem;
        flex: none;
    }

    .theme-icon-body {
        fill: currentColor;
        opacity: 1;
        transition: opacity 160ms ease;
        transition-delay: 120ms;
    }

    .theme-icon-moon {
        fill: currentColor;
        opacity: 0;
        transition: opacity 160ms ease;
    }

    .theme-icon-ray {
        fill: none;
        stroke: currentColor;
        stroke-width: 2.75;
        stroke-linecap: round;
        opacity: 1;
        transition: opacity 90ms linear;
        transition-delay: var(--ray-delay);
    }

    .theme-icon-ray:nth-child(1) {
        --ray-delay: 0ms;
    }
    .theme-icon-ray:nth-child(2) {
        --ray-delay: 30ms;
    }
    .theme-icon-ray:nth-child(3) {
        --ray-delay: 60ms;
    }
    .theme-icon-ray:nth-child(4) {
        --ray-delay: 90ms;
    }
    .theme-icon-ray:nth-child(5) {
        --ray-delay: 120ms;
    }
    .theme-icon-ray:nth-child(6) {
        --ray-delay: 150ms;
    }
    .theme-icon-ray:nth-child(7) {
        --ray-delay: 180ms;
    }
    .theme-icon-ray:nth-child(8) {
        --ray-delay: 210ms;
    }

    .theme-icon-sun-hole {
        transform: scale(1);
        transform-box: fill-box;
        transform-origin: center;
    }

    .theme-toggle[data-current-theme="dark"] .theme-icon-ray {
        opacity: 0;
    }

    .theme-toggle[data-current-theme="dark"] .theme-icon-body {
        opacity: 0;
    }

    .theme-toggle[data-current-theme="dark"] .theme-icon-moon {
        opacity: 1;
        transition-delay: 120ms;
    }
</style>

<script>
    type Theme = "light" | "dark";

    const storageKey = "arashi-works-theme";
    const root = document.documentElement;
    const colorSchemeQuery = window.matchMedia("(prefers-color-scheme: dark)");

    const toggle = document.querySelector(".theme-toggle");
    const label = toggle?.querySelector("[data-theme-label]");

    if (toggle instanceof HTMLButtonElement && label instanceof HTMLElement) {
        const getCurrentTheme = (): Theme => {
            const selectedTheme = root.dataset.theme;

            if (selectedTheme === "light" || selectedTheme === "dark") {
                return selectedTheme;
            }

            return colorSchemeQuery.matches ? "dark" : "light";
        };

        const updateToggle = (currentTheme: Theme) => {
            const nextTheme = currentTheme === "dark" ? "light" : "dark";
            const nextLabel =
                nextTheme === "dark" ? "切换到深色模式" : "切换到浅色模式";

            toggle.dataset.currentTheme = currentTheme;
            toggle.setAttribute("aria-label", nextLabel);
            label.textContent = nextLabel;
        };

        updateToggle(getCurrentTheme());
        toggle.hidden = false;

        toggle.addEventListener("click", () => {
            const currentTheme = getCurrentTheme();
            const nextTheme = currentTheme === "dark" ? "light" : "dark";

            root.dataset.theme = nextTheme;

            try {
                localStorage.setItem(storageKey, nextTheme);
            } catch {
                // 保存失败时，本次页面中的主题切换仍然有效。
            }

            updateToggle(nextTheme);
        });

        colorSchemeQuery.addEventListener("change", () => {
            if (!root.dataset.theme) {
                updateToggle(getCurrentTheme());
            }
        });
    }
</script>
