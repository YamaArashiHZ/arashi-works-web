---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
    workStatusLabels,
    workTypeLabels,
    type WorkStatus,
    type WorkType,
} from '../data/works';
import { tags, type TagSlug } from '../data/tags';
import { formatDateTime } from '../lib/dates';

interface Props {
    title: string;
    summary: string;
    cover?: ImageMetadata;
    type: WorkType;
    status: WorkStatus;
    updatedAt?: Date;
    tagSlugs: TagSlug[];
    href: string;
}

const { title, summary, cover, type, status, updatedAt, tagSlugs, href } = Astro.props;
---

<article>
    {cover && (
        <Image
            class="work-cover"
            src={cover}
            alt=""
            width={600}
        />
    )}
    <p class="work-meta">
        <span>{workTypeLabels[type]}</span>
        <span>{workStatusLabels[status]}</span>
    </p>
    <h2><a href={href}>{title}</a></h2>
    <p>{summary}</p>
    <ul class="work-tags" aria-label="作品标签">
        {tagSlugs.map((tagSlug) => (
            <li>{tags[tagSlug].name}</li>
        ))}
    </ul>
    {updatedAt && (
        <p>
            更新于{' '}
            <time datetime={updatedAt.toISOString()}>
                {formatDateTime(updatedAt)}
            </time>
        </p>
    )}
</article>

<style>
    .work-cover {
        display: block;
        width: 100%;
        height: auto;
    }
    .work-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .work-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>