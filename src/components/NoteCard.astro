---
import type { NoteCategorySlug } from "../data/categories";
import { noteCategories } from "../data/categories";
import { formatDateTime } from "../lib/dates";
import { tags, type TagSlug } from "../data/tags";

interface Props {
    title: string;
    summary: string;
    category: NoteCategorySlug;
    publishedAt: Date;
    updatedAt?: Date;
    href: string;
    tagSlugs: TagSlug[];
    readingMinutes: number;
    relatedWork?: {
        title: string;
        href: string;
    };
    headingLevel?: "h2" | "h3";
    variant?: "default" | "home";
}

const {
    title,
    summary,
    category,
    publishedAt,
    updatedAt,
    href,
    tagSlugs,
    readingMinutes,
    relatedWork,
    headingLevel = "h2",
    variant = "default",
} = Astro.props;

const Heading = headingLevel;
const homeDate = updatedAt ?? publishedAt;
const homeDateLabel = updatedAt ? "更新于" : "发布于";
---

<article class:list={["note-card", { "note-card-home": variant === "home" }]}>
    <Heading><a href={href}>{title}</a></Heading>
    <p class="note-category">{noteCategories[category].name}</p>
    <p class="note-summary">{summary}</p>
    <ul class="note-tags" aria-label="手记标签">
        {tagSlugs.map((tagSlug) => <li>{tags[tagSlug].name}</li>)}
    </ul>
    {
        relatedWork && (
            <p class="note-related-work">
                关联作品：
                <a href={relatedWork.href}>{relatedWork.title}</a>
            </p>
        )
    }
    <footer class="note-card-footer">
        <p class="note-engagement">
            <span>预计阅读 {readingMinutes} 分钟</span>
        </p>

        {
            variant === "home" ? (
                <p class="note-dates">
                    <span>
                        {homeDateLabel}{" "}
                        <time datetime={homeDate.toISOString()}>
                            {formatDateTime(homeDate)}
                        </time>
                    </span>
                </p>
            ) : (
                <p class="note-dates">
                    <span>
                        发布于{" "}
                        <time datetime={publishedAt.toISOString()}>
                            {formatDateTime(publishedAt)}
                        </time>
                    </span>

                    {updatedAt && (
                        <span>
                            更新于{" "}
                            <time datetime={updatedAt.toISOString()}>
                                {formatDateTime(updatedAt)}
                            </time>
                        </span>
                    )}
                </p>
            )
        }
    </footer>
</article>

<style>
    .note-card {
        display: grid;
        height: 100%;
        gap: var(--space-flow);
        padding: 1rem;
        border: 1px solid var(--color-border);
        border-radius: 0.75rem;
        background: var(--color-surface-raised);
        box-shadow: 0 0.5rem 1.25rem var(--color-shadow);
        container-type: inline-size;
    }

    .note-card > * {
        margin-block: 0;
    }

    .note-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .note-category,
    .note-tags,
    .note-related-work {
        font-size: var(--font-size-small);
    }

    .note-card-home {
        gap: 0.375rem;
        padding: 0.75rem 1rem;
    }

    .note-card-home .note-summary {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

    .note-card-footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        padding-block-start: 0.75rem;
        border-block-start: 1px solid var(--color-border);
    }

    .note-card-footer > * {
        margin-block: 0;
    }

    .note-engagement,
    .note-dates {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem 1rem;
        font-size: var(--font-size-small);
    }

    .note-dates {
        justify-content: flex-end;
        text-align: end;
    }

    @container (max-width: 32rem) {
        .note-card-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .note-dates {
            justify-content: flex-start;
            text-align: start;
        }
    }
</style>
