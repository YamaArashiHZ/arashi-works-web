---
import type { NoteCategorySlug } from "../data/categories";
import { noteCategories } from "../data/categories";
import { formatDateTime } from "../lib/dates";
import { tags, type TagSlug } from "../data/tags";

interface Props {
    title: string;
    summary: string;
    category: NoteCategorySlug;
    publishedAt: Date;
    updatedAt?: Date;
    href: string;
    tagSlugs: TagSlug[];
    readingMinutes: number;
    relatedWork?: {
        title: string;
        href: string;
    };
}

const {
    title,
    summary,
    category,
    publishedAt,
    updatedAt,
    href,
    tagSlugs,
    readingMinutes,
    relatedWork,
} = Astro.props;
---

<article>
    <p>{noteCategories[category].name}</p>
    <h2><a href={href}>{title}</a></h2>
    <p>{summary}</p>
    <ul class="note-tags" aria-label="手记标签">
        {tagSlugs.map((tagSlug) => <li>{tags[tagSlug].name}</li>)}
    </ul>
    <p class="note-meta">
        <span>
            发布于{" "}
            <time datetime={publishedAt.toISOString()}>
                {formatDateTime(publishedAt)}
            </time>
        </span>
        {
            updatedAt && (
                <span>
                    更新于{" "}
                    <time datetime={updatedAt.toISOString()}>
                        {formatDateTime(updatedAt)}
                    </time>
                </span>
            )
        }
        <span>预计阅读 {readingMinutes} 分钟</span>
    </p>
    {
        relatedWork && (
            <p>
                关联作品：
                <a href={relatedWork.href}>{relatedWork.title}</a>
            </p>
        )
    }
</article>

<style>
    .note-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .note-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }
</style>
