---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { Image, Picture } from "astro:assets";
import heroImage from "../assets/images/home/yamagiri-rin-hero.png";
import rinProfileImage from "../assets/images/home/yamagiri-rin-profile.png";
import { getPublishedWorks, getPublishedNotes } from "../lib/content";
import { estimateReadingMinutes } from "../lib/reading-time";
import WorkCard from "../components/WorkCard.astro";
import WorkGrid from "../components/WorkGrid.astro";
import NoteCard from "../components/NoteCard.astro";
import { tags, type TagSlug } from "../data/tags";
import { countContentByTag } from "../lib/tags";
import { getYearMonth } from "../lib/dates";

const works = await getPublishedWorks();
const featuredWorks = works.filter((work) => work.data.featured);
const notes = await getPublishedNotes();

const recentWorks = [...works]
	.sort((a, b) => {
		const aDate = a.data.updatedAt ?? a.data.publishedAt;
		const bDate = b.data.updatedAt ?? b.data.publishedAt;

		return bDate.getTime() - aDate.getTime();
	})
	.slice(0, 3);

const latestNotes = notes.slice(0, 3);

const popularTags = (Object.keys(tags) as TagSlug[])
	.map((slug) => ({
		slug,
		name: tags[slug].name,
		count: countContentByTag(slug, [works, notes]),
	}))
	.filter(({ count }) => count > 0)
	.sort((a, b) => b.count - a.count)
	.slice(0, 5);

interface ArchiveSummaryItem {
	year: string;
	month: string;
	count: number;
}

const archiveSummary = Array.from(
	notes.reduce((groups, note) => {
		const { year, month } = getYearMonth(note.data.publishedAt);
		const key = `${year}-${month}`;
		const existingGroup = groups.get(key);

		if (existingGroup) {
			existingGroup.count += 1;
		} else {
			groups.set(key, {
				year,
				month,
				count: 1,
			});
		}

		return groups;
	}, new Map<string, ArchiveSummaryItem>()),
	([, group]) => group,
).slice(0, 5);
---

<BaseLayout title={site.name} description={site.description}>
	<div class="home-layout">
		<div class="home-main">
			<section class="home-hero" aria-labelledby="home-title">
				<div class="home-hero-content">
					<h1 id="home-title">{site.name}</h1>
					<p class="home-brand-zh">{site.nameZh}</p>
					<p class="home-slogan" aria-label={site.slogan}>
						{
							site.sloganLines.map((line) => (
								<span aria-hidden="true">{line}</span>
							))
						}
					</p>

					<nav class="home-actions" aria-label="首页主要入口">
						<a href="/works/">浏览作品</a>
						<a href="/notes/">阅读手记</a>
					</nav>
				</div>

				<div class="home-hero-visual" aria-hidden="true">
					<Picture
						src={heroImage}
						formats={["avif", "webp"]}
						widths={[640, 960, 1440, 1920]}
						sizes="100vw"
						alt=""
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</section>

			{
				featuredWorks.length > 0 && (
					<section aria-labelledby="featured-works-title">
						<h2 id="featured-works-title">精选作品</h2>
						<p>探索 Arashi Works 的软件、游戏、模组与实验项目。</p>
						<WorkGrid>
							{featuredWorks.map((work) => (
								<li>
									<WorkCard
										title={work.data.title}
										summary={work.data.summary}
										cover={work.data.cover}
										type={work.data.type}
										status={work.data.status}
										updatedAt={work.data.updatedAt}
										tagSlugs={work.data.tags}
										href={`/works/${work.id}/`}
										headingLevel="h3"
									/>
								</li>
							))}
						</WorkGrid>

						<a href="/works/">浏览全部作品</a>
					</section>
				)
			}

			{
				recentWorks.length > 0 && (
					<section aria-labelledby="recent-works-title">
						<h2 id="recent-works-title">最近更新</h2>
						<p>查看最近更新或正在开发中的项目。</p>

						<WorkGrid>
							{recentWorks.map((work) => (
								<li>
									<WorkCard
										title={work.data.title}
										summary={work.data.summary}
										cover={work.data.cover}
										type={work.data.type}
										status={work.data.status}
										updatedAt={work.data.updatedAt}
										tagSlugs={work.data.tags}
										href={`/works/${work.id}/`}
										headingLevel="h3"
									/>
								</li>
							))}
						</WorkGrid>

						<a href="/works/">浏览全部作品</a>
					</section>
				)
			}

			{
				latestNotes.length > 0 && (
					<section aria-labelledby="latest-notes-title">
						<h2 id="latest-notes-title">异造手记</h2>
						<p>Arashi Works 的开发记录、技术笔记与创作过程。</p>

						<ul class="home-note-list">
							{latestNotes.map((note) => (
								<li>
									<NoteCard
										title={note.data.title}
										summary={note.data.summary}
										category={note.data.category}
										publishedAt={note.data.publishedAt}
										updatedAt={note.data.updatedAt}
										href={`/notes/${note.id}/`}
										tagSlugs={note.data.tags}
										readingMinutes={estimateReadingMinutes(
											note.body ?? "",
										)}
										headingLevel="h3"
									/>
								</li>
							))}
						</ul>

						<a href="/notes/">浏览全部手记</a>
					</section>
				)
			}
		</div>

		<aside class="home-sidebar" aria-label="首页辅助信息">
			<section class="home-rin-card" aria-labelledby="home-rin-title">
				<Image
					class="home-rin-profile"
					src={rinProfileImage}
					alt="山雾铃头像"
					width={192}
					height={192}
				/>
				<header class="home-rin-names">
					<h2 id="home-rin-title">山雾铃</h2>
					<p lang="ja">山霧りん</p>
					<p lang="en">Yamagiri Rin</p>
				</header>
				<p>山嵐异造坊的看板娘，山嵐的妹妹。</p>
				<a href="/about/yamagiri-rin/">查看角色资料</a>
			</section>

			<section aria-labelledby="home-tags-title">
				<h2 id="home-tags-title">热门标签</h2>
				{
					popularTags.length > 0 ? (
						<ul class="home-popular-tags">
							{popularTags.map(({ slug, name, count }) => (
								<li>
									<a
										href={`/search/?tag=${encodeURIComponent(slug)}`}
									>
										<span>{name}</span>
										<span
											aria-label={`${count} 项公开内容`}
										>
											{count}
										</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p>暂时没有公开标签。</p>
					)
				}
				<a href="/tags/">查看全部标签</a>
			</section>

			<section aria-labelledby="home-archive-title">
				<h2 id="home-archive-title">手记归档</h2>

				{
					archiveSummary.length > 0 ? (
						<ul class="home-archive-summary">
							{archiveSummary.map(({ year, month, count }) => (
								<li>
									<a
										href={`/notes/archive/#archive-month-${year}-${month}`}
									>
										<span>
											{year} 年 {month} 月
										</span>
										<span>{count} 篇</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p>暂时没有公开手记。</p>
					)
				}
				<a href="/notes/archive/">查看全部归档</a>
			</section>
		</aside>
	</div>

	<section aria-labelledby="about-studio-title">
		<h2 id="about-studio-title">关于异造坊</h2>
		<p>
			Arashi
			Works（山嵐异造坊）是记录个人创作与技术探索的空间，收录实用软件、游戏相关项目、自动化工具与开发手记，把兴趣和灵感逐步制作成可以使用、分享和持续改进的作品。
		</p>
	</section>

	<nav aria-label="异造坊联系方式">
		<ul class="studio-links">
			<li>
				<a href="https://github.com/YamaArashiHZ" target="_blank"
					>GitHub</a
				>
			</li>
			<li>
				<a href="https://space.bilibili.com/319279623" target="_blank"
					>B站</a
				>
			</li>
			<li>
				<span>arashiworks@qq.com</span>
			</li>
		</ul>
	</nav>
</BaseLayout>

<style>
	.home-layout,
	.home-main,
	.home-sidebar {
		display: grid;
	}

	.home-layout {
		gap: var(--space-section);
	}

	.home-main,
	.home-sidebar {
		align-content: start;
		gap: var(--space-section);
	}

	.home-sidebar > section {
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-surface-raised);
		box-shadow: 0 0.5rem 1.25rem var(--color-border);
	}

	.home-rin-card {
		text-align: center;
	}

	.home-rin-profile {
		display: block;
		width: clamp(6rem, 50%, 15rem);
		height: auto;
		margin-inline: auto;
		border: 0.2rem solid var(--color-border);
		border-radius: 50%;
		object-fit: cover;
		aspect-ratio: 1;
	}

	.home-rin-names {
		display: grid;
		gap: 0.125rem;
	}

	.home-rin-names > * {
		margin: 0;
	}

	.home-rin-names p {
		font-size: var(--font-size-small);
	}

	.home-popular-tags,
	.home-archive-summary {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-popular-tags a,
	.home-archive-summary a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.home-hero {
		position: relative;
		isolation: isolate;
		width: min(100%, 125rem);
		max-height: 42rem;
		margin-inline: auto;
		aspect-ratio: 2 / 1;
		overflow: hidden;
		border-radius: 1.5rem;
	}

	.home-hero > * {
		margin-block: 0;
	}

	.home-hero::after {
		position: absolute;
		z-index: 1;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgb(var(--hero-overlay-rgb) / 96%) 0%,
			rgb(var(--hero-overlay-rgb) / 88%) 22%,
			rgb(var(--hero-overlay-rgb) / 58%) 40%,
			rgb(var(--hero-overlay-rgb) / 18%) 58%,
			transparent 72%
		);
		content: "";
		pointer-events: none;
	}

	.home-hero-content {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: min(32rem, 55%);
		padding: clamp(2rem, 7vw, 6rem);
		display: grid;
		align-content: center;
		gap: 0.75rem;
	}

	.home-hero-content > * {
		margin-block: 0;
	}

	.home-hero-visual {
		position: absolute;
		z-index: 0;
		inset: 0;
	}

	.home-hero-visual :global(picture),
	.home-hero-visual :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.home-hero-visual :global(img) {
		object-fit: cover;
		object-position: right 20%;
	}

	.home-slogan span + span::before {
		content: "，";
	}

	@media (min-width: 64rem) {
		.home-layout {
			grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
			align-items: start;
		}

		.home-sidebar {
			position: sticky;
			inset-block-start: var(--space-page);
		}
	}

	@media (max-width: 50rem) {
		.home-hero-content {
			width: min(100%, 28rem);
			max-width: 28rem;
			padding: clamp(1rem, 5vw, 2rem);
		}
	}

	@media (max-width: 40rem) {
		.home-hero-content {
			width: min(72%, 20rem);
			padding: 0.5rem 0.75rem;
			gap: 0.375rem;
		}

		.home-hero-content h1 {
			font-size: clamp(1.5rem, 1.25rem + 1vw, 1.75rem);
			line-height: 1.15;
		}

		.home-brand-zh,
		.home-slogan {
			font-size: 0.875rem;
			line-height: 1.35;
		}
	}

	@media (max-width: 63.99rem) {
		.home-hero {
			aspect-ratio: 21 / 9;
		}
	}

	@media (max-width: 28.125rem) {
		.home-hero {
			aspect-ratio: 16 / 9;
		}
		.home-hero-content {
			width: 100%;
			max-width: none;
		}

		.home-hero-content h1 {
			font-size: clamp(1.375rem, calc(0.45rem + 4.62vw), 1.75rem);
			line-height: 1.15;
		}

		.home-brand-zh,
		.home-slogan {
			font-size: clamp(0.8125rem, calc(0.35rem + 2.31vw), 1rem);
			line-height: 1.3;
		}

		.home-slogan span {
			display: block;
		}

		.home-slogan span + span::before {
			content: none;
		}

		.home-actions {
			font-size: clamp(0.875rem, calc(0.57rem + 1.54vw), 1rem);
			line-height: 1.35;
		}
	}

	.home-note-list {
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.studio-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
