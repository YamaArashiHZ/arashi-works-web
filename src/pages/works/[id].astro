---
import {
    render,
    type CollectionEntry,
} from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
    getPublishedNotesByWork,
    getPublishedWorks,
} from '../../lib/content';
import NoteCard from '../../components/NoteCard.astro';
import {
    workStatusLabels,
    workTypeLabels,
    workPlatformLabels,
} from '../../data/works';
import { tags } from '../../data/tags';
import { formatDateTime } from '../../lib/dates';
import { estimateReadingMinutes } from '../../lib/reading-time';

type PublishedWork = CollectionEntry<'works'> & {
    data: CollectionEntry<'works'>['data'] & {
        publishedAt: Date;
    };
};

interface Props {
    work: PublishedWork;
}

export async function getStaticPaths() {
    const works = await getPublishedWorks();

    return works.map((work) => ({
        params: { id: work.id },
        props: { work },
    }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const relatedNotes = await getPublishedNotesByWork(work.id);
---

<BaseLayout
    title={`${work.data.title} | Arashi Works`}
    description={work.data.summary}
>
    <p><a href="/works/">返回作品列表</a></p>
    <h1>{work.data.title}</h1>
    <p>{work.data.summary}</p>

    <p class="work-update">
        <span>
            发布于{' '}
            <time datetime={work.data.publishedAt.toISOString()}>
                {formatDateTime(work.data.publishedAt)}
            </time>
        </span>

        {work.data.updatedAt && (
            <span>
                更新于{' '}
                <time datetime={work.data.updatedAt.toISOString()}>
                    {formatDateTime(work.data.updatedAt)}
                </time>
            </span>
        )}
    </p>
    <dl class="work-meta">
        <div>
            <dt>类型</dt>
            <dd>{workTypeLabels[work.data.type]}</dd>
        </div>
        <div>
            <dt>状态</dt>
            <dd>{workStatusLabels[work.data.status]}</dd>
        </div>
        <div>
            <dt>平台</dt>
            <dd>
                {work.data.platforms.map((platform) => workPlatformLabels[platform]).join('、')}
            </dd>
        </div>
        <div>
            <dt>标签</dt>
            <dd>
                {work.data.tags.map((tagSlug) => tags[tagSlug].name).join('、')}
            </dd>
        </div>
        {work.data.license && (
            <div>
                <dt>许可证</dt>
                <dd>{work.data.license}</dd>
            </div>
        )}
    </dl>
    {(work.data.repositoryUrl || work.data.feedbackUrl) && (
        <nav class="work-actions" aria-label="项目链接">
            {work.data.repositoryUrl && (
                <a href={work.data.repositoryUrl}>查看源代码</a>
            )}
            {work.data.feedbackUrl && (
                <a href={work.data.feedbackUrl}>反馈问题</a>
            )}
        </nav>
    )}
    {work.data.cover && (
        <Image
            class="work-cover"
            src={work.data.cover}
            alt=""
            width={1200}
        />
    )}
    <section aria-labelledby="work-description">
        <h2 id="work-description">作品介绍</h2>
        <Content />
    </section>

    {relatedNotes.length > 0 && (
        <section aria-labelledby="related-notes">
            <h2 id="related-notes">相关异造手记</h2>
            <ul class="related-notes">
                {relatedNotes.map((note) => (
                    <li>
                        <NoteCard
                            title={note.data.title}
                            summary={note.data.summary}
                            category={note.data.category}
                            publishedAt={note.data.publishedAt}
                            href={`/notes/${note.id}/`}
                            tagSlugs={note.data.tags}
                            readingMinutes={estimateReadingMinutes(note.body ?? '')}
                        />
                    </li>
                ))}
            </ul>
        </section>
    )}
</BaseLayout>

<style>
    .work-cover {
        display: block;
        width: 100%;
        max-width: 75rem;
        height: auto;
    }

    .work-update {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .work-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .work-meta div {
        display: flex;
        gap: 0.5rem;
    }

    .work-meta dd {
        margin: 0;
    }

    .work-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .related-notes {
        display: grid;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>