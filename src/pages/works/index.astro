---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedWorks } from '../../lib/content';
import WorkCard from '../../components/WorkCard.astro';

const works = await getPublishedWorks();
---

<BaseLayout
    title="作品 | Arashi Works"
    description="浏览 Arashi Works 的软件、游戏与实验项目。"
>
    <h1>作品</h1>
    <p>这里收录 Arashi Works 的软件、游戏与实验项目。</p>
    {works.length > 0 ? (
        <p>公开作品：{works.length}</p>
        <ul>
            {works.map((work) => (
                <li><WorkCard
                    title={work.data.title}
                    summary={work.data.summary}
                    cover={work.data.cover}
                    type={work.data.type}
                    status={work.data.status}
                    updatedAt={work.data.updatedAt}
                    tagSlugs={work.data.tags}
                /></li>
            ))}
        </ul>
    ) : (
        <p>暂时没有公开作品。</p>
    )}
</BaseLayout>